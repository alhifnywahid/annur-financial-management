# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
# Generate with: npx -y @better-auth/cli secret
BETTER_AUTH_SECRET=

# Google OAuth (Google Cloud Console). Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email allowed to access the admin panel (gate by email)
ADMIN_EMAIL=admin@gmail.com

# ---------------------------------------------------------------------------
# One-time data migration ONLY (old MongoDB source).
# Remove after running `npm run migrate:data`.
# ---------------------------------------------------------------------------
MONGO_URI=
