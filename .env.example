# ============================================================
# ANNUR OFFICIAL - Environment Variables Template
# ============================================================
# Salin file ini menjadi .env (atau .env.local untuk Next.js)
# Isi setiap variabel dengan nilai yang sesuai.
# JANGAN pernah commit file .env ke repository!
# ============================================================

# ----------------------------------------------------------
# AUTENTIKASI - Google OAuth
# Dapatkan dari: https://console.cloud.google.com
# Buat OAuth 2.0 Client ID pada menu Credentials.
# ----------------------------------------------------------
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# ----------------------------------------------------------
# AUTENTIKASI - NextAuth Secret
# Generate string acak dengan: openssl rand -base64 32
# ----------------------------------------------------------
AUTH_SECRET=your-random-nextauth-secret

# ----------------------------------------------------------
# AKSES ADMIN
# Hanya email ini yang diizinkan login sebagai admin.
# ----------------------------------------------------------
EMAIL=admin@gmail.com

# ----------------------------------------------------------
# DATABASE - MongoDB
# Dapatkan connection string dari: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>/<dbname>
# ----------------------------------------------------------
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority

# ----------------------------------------------------------
# URL APLIKASI
# Gunakan http://localhost:3000/api untuk development lokal.
# Ganti dengan URL production saat deploy.
# ----------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000/api
